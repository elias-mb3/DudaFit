{
  "name": "dudaFit",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:24-trixie",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "dudaFit", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "npm install -g npm@latest && npm install",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ]
    }
  },
  "runArgs": ["--userns=keep-id"],
  "containerUser": "node",
  "updateRemoteUserUID": true
}
